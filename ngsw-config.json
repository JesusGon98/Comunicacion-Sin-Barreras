{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/media/**"]
      }
    },
    {
      "name": "modelos",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/models/*.task",
          "/models/*.glb",
          "/mediapipe/wasm/vision_wasm_internal.*",
          "/signs/*.json"
        ]
      }
    }
  ]
}
